generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── User & Auth Models ───

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          String   // "hr_admin" | "manager" | "employee" | "recruiter" | "applicant"
  avatar        String?
  department    String?
  designation   String?
  phone         String?
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobApplications JobApplication[]
}

model JobApplication {
  id            String   @id @default(cuid())
  userId        String
  jobId         String
  jobTitle      String
  company       String
  status        String   @default("applied") // "applied" | "screening" | "interview" | "offered" | "rejected" | "withdrawn"
  matchScore    Float?
  appliedAt     DateTime @default(now())
  lastUpdatedAt DateTime @updatedAt
  notes         String?

  user          User @relation(fields: [userId], references: [id])
}

model Employee {
  id           String   @id @default(cuid())
  empId        String   @unique
  name         String
  email        String   @unique
  department   String
  designation  String
  joinDate     DateTime
  status       String   @default("active")
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attendance   Attendance[]
  leaves       LeaveRequest[]
  salary       SalaryStructure?
  payslips     Payslip[]
  loans        Loan[]
}

model Attendance {
  id           String   @id @default(cuid())
  employeeId   String
  date         DateTime
  checkIn      DateTime?
  checkOut     DateTime?
  totalHours   Float    @default(0)
  status       String   @default("present")
  shift        String   @default("general")
  location     String?
  regularizeReason String?
  regularizeStatus  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id])
}

model LeaveRequest {
  id           String   @id @default(cuid())
  employeeId   String
  leaveType    String
  fromDate     DateTime
  toDate       DateTime
  totalDays    Float
  halfDay      Boolean  @default(false)
  reason       String
  status       String   @default("pending")
  approverId   String?
  approverNote String?
  attachment   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id])
}

model LeaveBalance {
  id           String   @id @default(cuid())
  employeeId   String
  leaveType    String
  total        Float    @default(0)
  used         Float    @default(0)
  carried      Float    @default(0)
  year         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Holiday {
  id           String   @id @default(cuid())
  date         DateTime
  name         String
  type         String   @default("national")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Shift {
  id           String   @id @default(cuid())
  name         String
  startTime    String
  endTime      String
  graceMinutes Int      @default(15)
  type         String   @default("fixed")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SalaryStructure {
  id           String   @id @default(cuid())
  employeeId   String   @unique
  ctc          Float
  basic        Float
  hra          Float
  da           Float
  specialAllowance Float
  transport    Float
  medical      Float
  pf           Float
  esi          Float
  pt           Float
  tds          Float
  template     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id])
}

model Payslip {
  id           String   @id @default(cuid())
  employeeId   String
  month        Int
  year         Int
  grossPay     Float
  totalDeductions Float
  netPay       Float
  lopDays      Float    @default(0)
  overtime     Float    @default(0)
  status       String   @default("generated")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id])
}

model PayrollRun {
  id           String   @id @default(cuid())
  month        Int
  year         Int
  status       String   @default("draft")
  totalGross   Float    @default(0)
  totalNet     Float    @default(0)
  totalDeductions Float @default(0)
  employeesProcessed Int @default(0)
  anomalies    String?
  lockedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Loan {
  id           String   @id @default(cuid())
  employeeId   String
  loanType     String
  amount       Float
  tenure       Int
  emiAmount    Float
  outstanding  Float
  status       String   @default("active")
  startDate    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id])
}

// ─── Compliance & Audit Models ───

model AuditLog {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  action       String   // "score_override", "resume_analyzed", "blind_screening", "proposed_action", "human_confirm", "data_deleted"
  actor        String   // "system" | "human"
  actorId      String
  actorName    String?
  targetType   String   // "candidate" | "job" | "score" | "compliance"
  targetId     String
  details      String   // JSON string with full details
  hash         String   // SHA-256 tamper-proof hash
  previousHash String?  // Chain link to previous entry
  createdAt    DateTime @default(now())
}

model ScoreOverride {
  id             String   @id @default(cuid())
  timestamp      DateTime @default(now())
  userId         String
  userName       String
  candidateId    String
  candidateName  String
  jobId          String
  jobTitle       String
  dimension      String   // "skills" | "experience" | "education" | "cultureFit"
  itemId         String   // Specific scored item
  originalScore  Int      // 0-5
  newScore       Int      // 0-5
  reason         String   // MANDATORY - cannot be empty
  auditLogId     String?  // Link to audit log
  candidateScore CandidateScore @relation(fields: [candidateId], references: [candidateId])
  createdAt      DateTime @default(now())
}

model CandidateScore {
  id              String   @id @default(cuid())
  candidateId     String   @unique
  candidateName   String
  jobId           String
  jobTitle        String
  overallScore    Float    // 0-5
  skillsScore     Float
  experienceScore Float
  educationScore  Float
  cultureScore    Float
  confidence      Float    // 0-1
  riskLevel       String   // "low" | "medium" | "high" | "critical"
  proposedAction  String   // "proposed_interview" | "proposed_rejection" | "proposed_hold"
  humanConfirmed  Boolean  @default(false)
  confirmedBy     String?
  confirmedAt     DateTime?
  blindScore      Float?   // Score without PII
  biasAlert       Boolean  @default(false)
  analysisJson    String   // Full GlassBoxResult JSON
  resumeHash      String   // SHA-256 of original resume
  redactedHash    String?  // SHA-256 of redacted resume
  retentionDays   Int      @default(180)
  deletionDate    DateTime // Auto-deletion date
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  overrides       ScoreOverride[]
}

model BiasMetric {
  id              String   @id @default(cuid())
  auditDate       DateTime @default(now())
  auditType       String   // "4_5ths_rule" | "impact_ratio" | "ground_truth" | "calibration"
  demographicGroup String  // "gender" | "age" | "caste" | "location" | "overall"
  category        String   // "Male" | "Female" | "25-34" etc.
  totalCandidates Int
  selectedCount   Int
  selectionRate   Float
  impactRatio     Float?   // Must be >= 0.8
  passFourFifths  Boolean
  remediationNeeded Boolean @default(false)
  auditPeriod     String   // "2025-Q1" etc.
  thirdPartyAudited Boolean @default(false)
  details         String?  // JSON details
  createdAt       DateTime @default(now())
}

model DataRetentionPolicy {
  id              String   @id @default(cuid())
  dataType        String   // "resume_text" | "ai_scores" | "audit_logs" | "override_reasons" | "bias_metrics"
  retentionDays   Int
  description     String
  gdprCompliant   Boolean  @default(true)
  autoDelete      Boolean  @default(true)
  lastCleanup     DateTime?
  nextCleanup     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ComplianceAssessment {
  id              String   @id @default(cuid())
  framework       String   // "eu_ai_act" | "nyc_ll144" | "dpdp_act" | "gdpr"
  status          String   // "compliant" | "partially_compliant" | "non_compliant"
  assessmentDate  DateTime @default(now())
  nextAssessment  DateTime
  findings        String   // JSON
  remediationActions String? // JSON
  assessorName    String?
  version         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── HireMind Recruitment Models ───

model Job {
  id              String   @id @default(cuid())
  title           String
  department      String
  location        String
  type            String   @default("Full-time")
  status          String   @default("draft")  // draft, open, on-hold, closed, fulfilled
  openings        Int      @default(1)
  applicants      Int      @default(0)
  daysOpen        Int      @default(0)
  salary          String   @default("Competitive")
  postedDate      String   @default("")
  urgent          Boolean  @default(false)
  hiringManager   String   @default("")
  description     String   @default("")
  requirements    String   @default("[]")   // JSON array
  responsibilities String  @default("[]")   // JSON array
  experienceLevel String   @default("mid")  // fresher, 0-1, 1-3, 2-5, 3-5, 5-10, 10+
  skills          String   @default("[]")   // JSON array
  benefits        String   @default("[]")   // JSON array
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  candidates      Candidate[]
  aiAnalyses      AIAnalysis[]
}

model Candidate {
  id              String   @id @default(cuid())
  name            String
  email           String?
  phone           String?
  jobId           String
  stage           String   @default("sourced")  // sourced, screening, interview, assessment, offer, hired, rejected
  source          String   @default("Website")  // LinkedIn, Naukri, Referral, Website, Campus, Agency
  matchScore      Float    @default(0)
  scoreBreakdown  String   @default("{}")  // JSON: {skills, experience, education, culture, overall}
  daysInStage     Int      @default(0)
  appliedDate     String   @default("")
  lastActivity    String   @default("")
  location        String   @default("")
  experience      String   @default("")
  salary          String   @default("")
  timeline        String   @default("[]")  // JSON array of events
  resumeText      String?
  resumeFileName  String?
  avatar          String   @default("")
  role            String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  job             Job      @relation(fields: [jobId], references: [id])
  aiAnalyses      AIAnalysis[]
}

model AIAnalysis {
  id              String   @id @default(cuid())
  candidateId     String
  jobId           String
  analysisType    String   @default("full")  // full, quick, batch
  provider        String   @default("hiremind")  // hiremind, ollama, z-ai-sdk
  model           String   @default("qwen2.5")

  // Agent results stored as JSON
  parsedResume    String   @default("{}")    // Agent 1: Resume Parser
  domainDetection String   @default("{}")    // Agent 2: Domain Detector
  seniorityLevel  String   @default("{}")    // Agent 3: Seniority Detector
  skillExpansion  String   @default("{}")    // Agent 4: Skill Expansion
  jdParsing       String   @default("{}")    // Agent 5: JD Parser
  jobMatch        String   @default("{}")    // Agent 6: JD Match Engine
  achievements    String   @default("{}")    // Agent 7: Achievement Analyzer
  atsScore        String   @default("{}")    // Agent 8: ATS Scoring
  gapAnalysis     String   @default("{}")    // Agent 9: Gap Analyzer
  improvements    String   @default("{}")    // Agent 10: Resume Improvement
  interviewPrediction String @default("{}") // Agent 11: Interview Prediction
  recruiterInsights   String @default("{}") // Agent 12: Recruiter Insights
  masterResult    String   @default("{}")    // Final orchestrated result

  overallScore    Float    @default(0)
  shortlistDecision Boolean @default(false)
  confidence      Float    @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  candidate       Candidate @relation(fields: [candidateId], references: [id])
  job             Job       @relation(fields: [jobId], references: [id])
}

model RAGDocument {
  id              String   @id @default(cuid())
  docType         String   // "resume", "jd", "skill_taxonomy", "knowledge_base"
  sourceId        String?  // Link to Job or Candidate ID
  content         String   // Original text content
  embedding       String?  // JSON array of embedding vectors (for RAG similarity search)
  metadata        String   @default("{}")  // JSON metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
