generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── User & Auth Models ───

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          String   // "hr_admin" | "manager" | "employee" | "recruiter" | "applicant"
  avatar        String?
  department    String?
  designation   String?
  phone         String?
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobApplications JobApplication[]
}

model JobApplication {
  id            String   @id @default(cuid())
  userId        String
  jobId         String
  jobTitle      String
  company       String
  status        String   @default("applied") // "applied" | "screening" | "interview" | "offered" | "rejected" | "withdrawn"
  matchScore    Float?
  appliedAt     DateTime @default(now())
  lastUpdatedAt DateTime @updatedAt
  notes         String?

  user          User @relation(fields: [userId], references: [id])
}

model Employee {
  id           String   @id @default(cuid())
  empId        String   @unique
  name         String
  email        String   @unique
  department   String
  designation  String
  joinDate     DateTime
  status       String   @default("active")
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attendance   Attendance[]
  leaves       LeaveRequest[]
  salary       SalaryStructure?
  payslips     Payslip[]
  loans        Loan[]
}

model Attendance {
  id           String   @id @default(cuid())
  employeeId   String
  date         DateTime
  checkIn      DateTime?
  checkOut     DateTime?
  totalHours   Float    @default(0)
  status       String   @default("present")
  shift        String   @default("general")
  location     String?
  regularizeReason String?
  regularizeStatus  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id])
}

model LeaveRequest {
  id           String   @id @default(cuid())
  employeeId   String
  leaveType    String
  fromDate     DateTime
  toDate       DateTime
  totalDays    Float
  halfDay      Boolean  @default(false)
  reason       String
  status       String   @default("pending")
  approverId   String?
  approverNote String?
  attachment   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id])
}

model LeaveBalance {
  id           String   @id @default(cuid())
  employeeId   String
  leaveType    String
  total        Float    @default(0)
  used         Float    @default(0)
  carried      Float    @default(0)
  year         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Holiday {
  id           String   @id @default(cuid())
  date         DateTime
  name         String
  type         String   @default("national")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Shift {
  id           String   @id @default(cuid())
  name         String
  startTime    String
  endTime      String
  graceMinutes Int      @default(15)
  type         String   @default("fixed")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SalaryStructure {
  id           String   @id @default(cuid())
  employeeId   String   @unique
  ctc          Float
  basic        Float
  hra          Float
  da           Float
  specialAllowance Float
  transport    Float
  medical      Float
  pf           Float
  esi          Float
  pt           Float
  tds          Float
  template     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id])
}

model Payslip {
  id           String   @id @default(cuid())
  employeeId   String
  month        Int
  year         Int
  grossPay     Float
  totalDeductions Float
  netPay       Float
  lopDays      Float    @default(0)
  overtime     Float    @default(0)
  status       String   @default("generated")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id])
}

model PayrollRun {
  id           String   @id @default(cuid())
  month        Int
  year         Int
  status       String   @default("draft")
  totalGross   Float    @default(0)
  totalNet     Float    @default(0)
  totalDeductions Float @default(0)
  employeesProcessed Int @default(0)
  anomalies    String?
  lockedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Loan {
  id           String   @id @default(cuid())
  employeeId   String
  loanType     String
  amount       Float
  tenure       Int
  emiAmount    Float
  outstanding  Float
  status       String   @default("active")
  startDate    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id])
}

// ─── Compliance & Audit Models ───

model AuditLog {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  action       String   // "score_override", "resume_analyzed", "blind_screening", "proposed_action", "human_confirm", "data_deleted"
  actor        String   // "system" | "human"
  actorId      String
  actorName    String?
  targetType   String   // "candidate" | "job" | "score" | "compliance"
  targetId     String
  details      String   // JSON string with full details
  hash         String   // SHA-256 tamper-proof hash
  previousHash String?  // Chain link to previous entry
  createdAt    DateTime @default(now())
}

model ScoreOverride {
  id             String   @id @default(cuid())
  timestamp      DateTime @default(now())
  userId         String
  userName       String
  candidateId    String
  candidateName  String
  jobId          String
  jobTitle       String
  dimension      String   // "skills" | "experience" | "education" | "cultureFit"
  itemId         String   // Specific scored item
  originalScore  Int      // 0-5
  newScore       Int      // 0-5
  reason         String   // MANDATORY - cannot be empty
  auditLogId     String?  // Link to audit log
  candidateScore CandidateScore @relation(fields: [candidateId], references: [candidateId])
  createdAt      DateTime @default(now())
}

model CandidateScore {
  id              String   @id @default(cuid())
  candidateId     String   @unique
  candidateName   String
  jobId           String
  jobTitle        String
  overallScore    Float    // 0-5
  skillsScore     Float
  experienceScore Float
  educationScore  Float
  cultureScore    Float
  confidence      Float    // 0-1
  riskLevel       String   // "low" | "medium" | "high" | "critical"
  proposedAction  String   // "proposed_interview" | "proposed_rejection" | "proposed_hold"
  humanConfirmed  Boolean  @default(false)
  confirmedBy     String?
  confirmedAt     DateTime?
  blindScore      Float?   // Score without PII
  biasAlert       Boolean  @default(false)
  analysisJson    String   // Full GlassBoxResult JSON
  resumeHash      String   // SHA-256 of original resume
  redactedHash    String?  // SHA-256 of redacted resume
  retentionDays   Int      @default(180)
  deletionDate    DateTime // Auto-deletion date
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  overrides       ScoreOverride[]
}

model BiasMetric {
  id              String   @id @default(cuid())
  auditDate       DateTime @default(now())
  auditType       String   // "4_5ths_rule" | "impact_ratio" | "ground_truth" | "calibration"
  demographicGroup String  // "gender" | "age" | "caste" | "location" | "overall"
  category        String   // "Male" | "Female" | "25-34" etc.
  totalCandidates Int
  selectedCount   Int
  selectionRate   Float
  impactRatio     Float?   // Must be >= 0.8
  passFourFifths  Boolean
  remediationNeeded Boolean @default(false)
  auditPeriod     String   // "2025-Q1" etc.
  thirdPartyAudited Boolean @default(false)
  details         String?  // JSON details
  createdAt       DateTime @default(now())
}

model DataRetentionPolicy {
  id              String   @id @default(cuid())
  dataType        String   // "resume_text" | "ai_scores" | "audit_logs" | "override_reasons" | "bias_metrics"
  retentionDays   Int
  description     String
  gdprCompliant   Boolean  @default(true)
  autoDelete      Boolean  @default(true)
  lastCleanup     DateTime?
  nextCleanup     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ComplianceAssessment {
  id              String   @id @default(cuid())
  framework       String   // "eu_ai_act" | "nyc_ll144" | "dpdp_act" | "gdpr"
  status          String   // "compliant" | "partially_compliant" | "non_compliant"
  assessmentDate  DateTime @default(now())
  nextAssessment  DateTime
  findings        String   // JSON
  remediationActions String? // JSON
  assessorName    String?
  version         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
